files:
  "/opt/elasticbeanstalk/tasks/cleanup.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Clean up old deployments and temporary files
      find /var/app -name "*.pyc" -delete
      find /var/app -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
      rm -rf /tmp/* 2>/dev/null || true
      rm -rf /var/tmp/* 2>/dev/null || true
      # Clean pip cache
      pip cache purge 2>/dev/null || true


